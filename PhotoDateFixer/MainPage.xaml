<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhotoDateFixer.MainPage"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="12"
        RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <Label
            Grid.Row="0"
            Text="Photo Date Fixer"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,4,0,12"/>

        <!-- Select -->
        <Button
            Grid.Row="1"
            HeightRequest="44"
            CornerRadius="10"
            Text="Select Photos"
            Clicked="OnSelectPhotosClicked"/>

        <!-- Status -->
        <Label
            Grid.Row="2"
            x:Name="StatusLabel"
            FontSize="13"
            HorizontalOptions="Center"
            Margin="0,8"/>

        <!-- Photos -->
        <CollectionView
            Grid.Row="3"
            x:Name="PhotoList"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame
                        Margin="0,4"
                        Padding="8"
                        CornerRadius="12"
                        BorderColor="#DDDDDD"
                        HasShadow="False">

                        <Grid
                            ColumnDefinitions="60,*"
                            ColumnSpacing="10">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnPhotoTapped"/>
                            </Grid.GestureRecognizers>

                            <!-- Thumbnail -->

                            <!-- Thumbnail -->
                            <Grid
    Grid.Column="0"
    WidthRequest="64"
    HeightRequest="64">

                                <Image
        Source="{Binding Thumbnail}"
        Aspect="AspectFill"
        WidthRequest="64"
        HeightRequest="64"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"/>

                            </Grid>

                            <!-- Info -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3">

                                <!-- First Row -->

                                <Grid
                                    ColumnDefinitions="Auto,*">

                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding IsSelected}"
                                        InputTransparent="True"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding FileName}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        VerticalTextAlignment="Center"/>

                                </Grid>

                                <!-- Date -->

                                <Label
                                    Text="{Binding DetectedDate,StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                    FontSize="11"
                                    TextColor="#555555"/>

                                <!-- Source + Confidence -->

                                <HorizontalStackLayout
                                    Spacing="10">

                                    <Frame
                                        Padding="6,2"
                                        CornerRadius="6"
                                        BackgroundColor="#E8F5E9"
                                        HasShadow="False">

                                        <Label
                                            Text="{Binding Source}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#2E7D32"/>

                                    </Frame>

                                    <Label
                                        Text="{Binding Confidence,StringFormat='Confidence {0}%'}"
                                        FontSize="10"
                                        VerticalOptions="Center"
                                        TextColor="Gray"/>

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Grid>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Bottom Controls -->

        <Frame
            Grid.Row="4"
            Margin="0,10,0,0"
            Padding="10"
            CornerRadius="12"
            BorderColor="#DDDDDD"
            HasShadow="False">

            <VerticalStackLayout
                Spacing="8">

                <Label
                    Text="Manual Date &amp; Time"
                    FontSize="15"
                    FontAttributes="Bold"/>

                <DatePicker
                    x:Name="ManualDatePicker"/>

                <TimePicker
                    x:Name="ManualTimePicker"
                    Format="HH:mm"/>

                <Button
                    HeightRequest="44"
                    CornerRadius="10"
                    Text="Apply To Selected"
                    Clicked="OnSetDateClicked"/>

                <Button
                    HeightRequest="44"
                    CornerRadius="10"
                    Text="Fix Dates"
                    Clicked="OnFixDatesClicked"/>

            </VerticalStackLayout>

        </Frame>

    </Grid>

</ContentPage>