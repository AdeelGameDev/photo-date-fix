<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhotoDateFixer.MainPage"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Label
            Grid.Row="0"
            Text="Photo Date Fixer"
            FontSize="30"
            HorizontalOptions="Center"/>

        <Button
            Grid.Row="1"
            Text="Select Photos"
            Clicked="OnSelectPhotosClicked"/>

        <Label
            Grid.Row="2"
            x:Name="StatusLabel"
            Text="No photos selected"
            HorizontalOptions="Center"/>

        <CollectionView
            Grid.Row="3"
            x:Name="PhotoList">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <VerticalStackLayout Padding="10">

                        <Label
                            Text="{Binding FileName}"
                            FontSize="14"/>

                        <Label
                            Text="{Binding DisplayDate}"
                            FontSize="12"/>

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>


        <Button
            Grid.Row="4"
            Text="Fix Dates"
            Clicked="OnFixDatesClicked"/>

    </Grid>

</ContentPage>